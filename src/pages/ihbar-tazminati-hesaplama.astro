---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  STAMP_TAX_RATE,
  TAX_BRACKETS,
  NOTICE_PERIODS,
  DAYS_PER_MONTH_CALCULATION,
  DAYS_PER_WEEK,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';
import { calculateNoticeSeverance } from '../utils/calc-web';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"
const gvYuzde = formatPercent(TAX_BRACKETS[0].rate, 0); // "15"
const gunBolen = formatInt(DAYS_PER_MONTH_CALCULATION); // "30"

// İhbar süresi kademeleri (İş Kanunu m.17) — hesaplayıcının kullandığı sabitler
const kademeler = [
  { sure: "6 aydan az", hafta: NOTICE_PERIODS.lessThan6Months },
  { sure: "6 ay - 1,5 yıl", hafta: NOTICE_PERIODS.sixMonthsTo18Months },
  { sure: "1,5 - 3 yıl", hafta: NOTICE_PERIODS.eighteenMonthsTo3Years },
  { sure: "3 yıl ve üzeri", hafta: NOTICE_PERIODS.threeYearsPlus },
];

// Açıklama için örnek hesap — hesaplayıcının kullandığı fonksiyonun kendisi
const ornMaas = 45000;
const ornYil = 5;
const orn = calculateNoticeSeverance(ornMaas, ornYil);

const faqItems = [
  {
    question: "İhbar tazminatı nedir?",
    answer: "İhbar tazminatı, iş sözleşmesi ihbar süresine uyulmadan (önceden haber verilmeden) sona erdirildiğinde, sözleşmeyi fesheden tarafın karşı tarafa ödediği tazminattır. Kıdem süresine göre 2, 4, 6 veya 8 haftalık ücrete karşılık gelir.",
  },
  {
    question: "İhbar süresi kıdeme göre kaç haftadır?",
    answer: `İş Kanunu m.17'ye göre: ${kademeler.map((k) => `${k.sure} = ${k.hafta} hafta`).join('; ')}. Örneğin ${ornYil} yıl kıdem = ${orn.noticeWeeks} hafta ihbar süresine karşılık gelir.`,
  },
  {
    question: "Haftalık ücret nasıl hesaplanır?",
    answer: `Önce günlük brüt ücret bulunur (aylık brüt / ${gunBolen}), sonra 7 ile çarpılır. Örneğin ${formatInt(ornMaas)} TL aylık brüt için haftalık ücret = ${formatInt(ornMaas)} / ${gunBolen} × ${DAYS_PER_WEEK} = ${formatTL(orn.weeklyRate)} TL olur.`,
  },
  {
    question: "İhbar tazminatından ne kadar kesinti yapılır?",
    answer: `Kıdem tazminatından farklı olarak ihbar tazminatı gelir vergisine tabidir. Brüt tutardan gelir vergisi (hesaplayıcıda yüzde ${gvYuzde} varsayılır) ve yüzde ${damgaYuzde} damga vergisi kesilir; SGK primi kesilmez. Yıl içindeki kümülatif matrahın üst dilime geçmişse gerçek gelir vergisi daha yüksek olabilir.`,
  },
  {
    question: "İhbar süresi vermek zorunlu mu?",
    answer: "İş sözleşmesini feshetmek isteyen taraf (işçi veya işveren) ihbar süresine uymak zorundadır. Süreye uyulmadan yapılan fesihte, karşı tarafa ihbar tazminatı ödenmesi gerekir.",
  },
  {
    question: "İhbar ve kıdem tazminatı birlikte alınabilir mi?",
    answer: "Evet. Koşulları oluştuğunda ihbar tazminatı ile kıdem tazminatı birbirinden bağımsız olarak ayrı ayrı ödenebilir. İki tutarı ilgili hesaplayıcılardan ayrı ayrı hesaplayabilirsiniz.",
  },
];

const relatedTools = [
  {
    title: "Fazla Mesai Ücreti",
    url: "/fazla-mesai-hesaplama/",
    description: "Ayda kaç saat fazla mesai yaptıysan ücretini hesapla.",
  },
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama/",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "Net-Brüt Maaş",
    url: "/net-brut-maas-hesaplama/",
    description: "Brüt ve net maaş arasında dönüşüm yap.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="İhbar Tazminatı Hesaplama 2026 — Kıdeme Göre Ücretsiz Araç"
  description="Kıdem sürene göre ihbar süreni (2–8 hafta) ve net ihbar tazminatını 2026 değerleriyle anında, tamamen ücretsiz ve tarayıcında gizli olarak hesapla."
>
  <Calculator
    title="İhbar Tazminatı Hesaplayıcı"
    description="Aylık brüt maaşını ve kıdem süreni gir, tahmini ihbar tazminatı tutarını öğren."
    resultLabel="Tahmini İhbar Tazminatı (Net):"
    resultValue="TL 0,00"
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label for="gross-notice">Aylık Brüt Maaş (TL)</label><br />
        <input
          id="gross-notice"
          type="number"
          placeholder="45000"
          min="0"
          step="100"
          value="45000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div>
        <label for="years-notice">Kıdem Yılı</label><br />
        <input
          id="years-notice"
          type="number"
          placeholder="5"
          min="0"
          max="50"
          step="0.5"
          value="5"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>İhbar Süresi:</span>
          <strong id="notice-weeks">0</strong> <span style="margin-left: 0.25rem;">hafta</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Haftalık Ücret:</span>
          <strong id="weekly-rate">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Brüt Tazminat:</span>
          <strong id="gross-notice-amount">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Gelir Vergisi:</span>
          <strong id="tax-notice">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Damga Vergisi:</span>
          <strong id="stamp-notice">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Net Tazminat:</span>
          <strong id="net-notice">TL 0,00</strong>
        </div>
      </div>
    </div>
  </Calculator>

  <Explanation>
    <p>
      İhbar tazminatı, iş sözleşmesi <strong>ihbar süresine uyulmadan</strong>
      feshedildiğinde ödenir. Tutar, kıdem süresine bağlı ihbar süresi (hafta)
      ile haftalık ücretin çarpımıdır. Hesap üç adımdan oluşur:
    </p>
    <ul>
      <li><strong>Haftalık ücret</strong> = aylık brüt maaş / {gunBolen} × {DAYS_PER_WEEK} (7 günlük ücret).</li>
      <li>
        <strong>Brüt ihbar tazminatı</strong> = haftalık ücret × ihbar süresi (hafta).
        İhbar süresi kıdeme göre belirlenir:
      </li>
    </ul>
    <ul>
      {kademeler.map((k) => (
        <li>{k.sure}: <strong>{k.hafta} hafta</strong></li>
      ))}
    </ul>
    <ul>
      <li><strong>Net tutar</strong> = brüt tutardan gelir vergisi (yüzde {gvYuzde}) ve damga vergisi (yüzde {damgaYuzde}) düşülür. SGK primi kesilmez.</li>
    </ul>
    <div class="example">
      <p>
        <strong>Örnek:</strong> {ornYil} yıl kıdemi olan, aylık {formatInt(ornMaas)} TL
        brüt maaşlı biri. {ornYil} yıl kıdem "3 yıl ve üzeri" kademesine girdiği için
        ihbar süresi <strong>{orn.noticeWeeks} haftadır</strong>.
      </p>
      <p>Haftalık ücret = {formatInt(ornMaas)} / {gunBolen} × {DAYS_PER_WEEK} = {formatTL(orn.weeklyRate)} TL.</p>
      <p>Brüt ihbar tazminatı = {formatTL(orn.weeklyRate)} × {orn.noticeWeeks} = {formatTL(orn.noticeAmount)} TL.</p>
      <p>Gelir vergisi = {formatTL(orn.noticeAmount)} × yüzde {gvYuzde} = {formatTL(orn.incomeTax)} TL.</p>
      <p>Damga vergisi = {formatTL(orn.noticeAmount)} × yüzde {damgaYuzde} = {formatTL(orn.stampTax)} TL.</p>
      <p class="result">Net ihbar tazminatı ≈ {formatTL(orn.netAmount)} TL.</p>
    </div>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="ihbar" />

  <Disclaimer />
</BaseLayout>

<script>
  // Hesap mantığı tek kaynakta: utils/calc-web.ts (mobil ihbarTazminati ile birebir)
  import { calculateNoticeSeverance } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

  function resetDisplay() {
    document.getElementById('notice-weeks').textContent = '0';
    document.getElementById('weekly-rate').textContent = 'TL 0,00';
    document.getElementById('gross-notice-amount').textContent = 'TL 0,00';
    document.getElementById('tax-notice').textContent = '-TL 0,00';
    document.getElementById('stamp-notice').textContent = '-TL 0,00';
    document.getElementById('net-notice').textContent = 'TL 0,00';
    const resultValue = document.getElementById('result-value');
    if (resultValue) resultValue.textContent = 'TL 0,00';
  }

  function calculateNotice() {
    const gross = parseFloat(document.getElementById('gross-notice').value) || 0;
    const years = parseFloat(document.getElementById('years-notice').value) || 0;

    if (gross <= 0) {
      resetDisplay();
      return;
    }

    const r = calculateNoticeSeverance(gross, years);

    document.getElementById('notice-weeks').textContent = r.noticeWeeks;
    document.getElementById('weekly-rate').textContent = `TL ${fmt(r.weeklyRate)}`;
    document.getElementById('gross-notice-amount').textContent = `TL ${fmt(r.noticeAmount)}`;
    document.getElementById('tax-notice').textContent = `-TL ${fmt(r.incomeTax)}`;
    document.getElementById('stamp-notice').textContent = `-TL ${fmt(r.stampTax)}`;
    document.getElementById('net-notice').textContent = `TL ${fmt(r.netAmount)}`;

    const resultValue = document.getElementById('result-value');
    if (resultValue) resultValue.textContent = `TL ${fmt(r.netAmount)}`;
  }

  function init() {
    const grossInput = document.getElementById('gross-notice');
    const yearsInput = document.getElementById('years-notice');

    if (!grossInput || !yearsInput) {
      console.error('Ihbar tazminati: input elemanlari bulunamadi');
      return;
    }

    grossInput.addEventListener('input', calculateNotice);
    yearsInput.addEventListener('input', calculateNotice);
    calculateNotice();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
