---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  SEVERANCE_CEILINGS,
  SEVERANCE_DAYS_PER_YEAR,
  SEVERANCE_YEAR_DAYS,
  STAMP_TAX_RATE,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';
import { calculateSeverance } from '../utils/calc-web';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const capH1Str = formatTL(SEVERANCE_CEILINGS[0].annualCap); // "64.948,77"
const capH2Str = formatTL(SEVERANCE_CEILINGS[1].annualCap); // "73.729,84"
const gunYil = formatInt(SEVERANCE_DAYS_PER_YEAR); // "30"
const yilGun = formatInt(SEVERANCE_YEAR_DAYS); // "365"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"

// Örnekler — hesaplayıcının kullandığı fonksiyonun kendisiyle hesaplanır
const ornGiris = '2021-08-15';
const ornCikis = '2026-08-15'; // 2026 II. yarı → H2 tavanı
const ornTarih = '15.08.2021 – 15.08.2026';
const orn1Maas = 30000;
const orn1 = calculateSeverance(ornGiris, ornCikis, orn1Maas);
const orn2Maas = 100000;
const orn2 = calculateSeverance(ornGiris, ornCikis, orn2Maas);

const faqItems = [
  {
    question: "Kıdem tazminatı nasıl hesaplanır?",
    answer: `Her tam yıl için bir aylık (${gunYil} günlük) giydirilmiş brüt ücret ödenir; artan süre gün hesabıyla orantılı eklenir. Kısaca brüt = kıdeme esas ücret × çalışılan gün / ${yilGun}. Örneğin ${formatInt(orn1Maas)} TL brüt maaşla ${ornTarih} arası çalışan biri ${formatInt(orn1.totalDays)} gün kıdeme sahiptir; brüt tazminatı ${formatTL(orn1.grossAmount)} TL olur. Kendi tarihlerinle hesaplamak için yukarıdaki aracı kullanabilirsin.`,
  },
  {
    question: "Kıdem tazminatı tavanı nedir?",
    answer: `Kıdeme esas ücret, işten çıkış tarihinin düştüğü dönemin tavanını aşamaz. 2026 resmi tavanları: 1 Ocak - 30 Haziran 2026 arası ${capH1Str} TL; 1 Temmuz - 31 Aralık 2026 arası ${capH2Str} TL. Aylık brüt maaşın bu tutarın üzerindeyse hesapta tavan tutarı kullanılır.`,
  },
  {
    question: "1 yıldan az çalışırsam kıdem tazminatı alabilir miyim?",
    answer: `Hayır. İş Kanunu'na göre kıdem tazminatına hak kazanmak için aynı işverende en az 1 tam yıl (${yilGun} gün) çalışmış olmak gerekir. Daha kısa sürede tazminat hakkı doğmaz ve hesaplayıcı 0 gösterir.`,
  },
  {
    question: "Artık ay ve günler nasıl hesaplanır?",
    answer: `Hesap, işe giriş ile işten çıkış arasındaki gerçek takvim günü üzerinden yapılır: her ${yilGun} gün bir yıllık ücrete karşılık gelir, artan günler aynı oranla eklenir. Bu yüzden ay ve gün sayısını ayrıca girmen gerekmez; iki tarihi girmen yeterlidir.`,
  },
  {
    question: "Damga vergisi ne kadar kesilir?",
    answer: `Kıdem tazminatının brüt tutarından yüzde ${damgaYuzde} oranında damga vergisi kesilir. Net tutar = brüt tutar - damga vergisi. Kıdem tazminatından gelir vergisi ve SGK primi kesilmez.`,
  },
  {
    question: "Sonuç kesin mi?",
    answer: "Hesaplanan tutar tahminidir; kesin hesap için muhasebe uzmanına danışmanı öneririz. Kıdem tavanı yılın her yarısında güncellenir ve giydirilmiş ücret (yol, yemek, ikramiye gibi düzenli ek ödemeler) hesabı sonucu artırabilir.",
  },
];

const relatedTools = [
  {
    title: "Fazla Mesai Ücreti",
    url: "/fazla-mesai-hesaplama/",
    description: "Ayda kaç saat fazla mesai yaptıysan ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama/",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Net-Brüt Maaş",
    url: "/net-brut-maas-hesaplama/",
    description: "Brüt ve net maaş arasında dönüşüm yap.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="Kıdem Tazminatı Hesaplama 2026 — Güncel Tavanla Ücretsiz"
  description="Maaşını, işe giriş ve çıkış tarihini gir; 2026 kıdem tavanı ve damga vergisiyle net kıdem tazminatını anında, ücretsiz ve gizli hesapla."
>
  <Calculator
    title="Kıdem Tazminatı Hesaplayıcı"
    description="Aylık brüt maaşını, işe giriş ve işten çıkış tarihini gir, tahmini kıdem tazminatını öğren."
    resultLabel="Tahmini Kıdem Tazminatı (Net):"
    resultValue="TL 0,00"
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label for="gross-severance">Aylık Brüt Maaş (TL)</label><br />
        <input
          id="gross-severance"
          type="number"
          placeholder="45000"
          min="0"
          step="100"
          value="45000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div>
        <label for="entry-date-severance">İşe Giriş Tarihi</label><br />
        <input
          id="entry-date-severance"
          type="date"
          value="2016-07-21"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div>
        <label for="exit-date-severance">İşten Çıkış Tarihi</label><br />
        <input
          id="exit-date-severance"
          type="date"
          value="2026-07-21"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
        <small id="ceiling-note" style="display: block; margin-top: 0.35rem; color: #6b7280;"></small>
      </div>

            <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Çalışma Süresi:</span>
          <strong id="total-days">0 gün</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Kıdeme Esas Ücret:</span>
          <strong id="capped-annual">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Brüt Tazminat:</span>
          <strong id="gross-severance-amount">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Damga Vergisi:</span>
          <strong id="stamp-severance">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Net Tazminat:</span>
          <strong id="net-severance">TL 0,00</strong>
        </div>
      </div>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Kıdem tazminatı, aynı işverende en az <strong>1 yıl</strong> çalışıp iş
      sözleşmesi tazminata hak kazandıran bir nedenle sona eren çalışanlara ödenir.
      Her tam yıl için <strong>bir aylık ({gunYil} günlük) giydirilmiş brüt ücret</strong>
      esas alınır. Hesap şöyle işler:
    </p>
    <ul>
      <li>
        <strong>Kıdeme esas yıllık ücret</strong> = aylık brüt maaş; ancak bu tutar,
        işten çıkış tarihinin düştüğü dönemin <strong>kıdem tavanını</strong> aşamaz.
        2026 tavanları: yılın ilk yarısı {capH1Str} TL, ikinci yarısı {capH2Str} TL.
      </li>
      <li><strong>Brüt tazminat</strong> = kıdeme esas ücret × çalışılan gün / {yilGun}. Gün sayısı, işe giriş ile işten çıkış arasındaki gerçek takvim günüdür (artık yıllar dahil).</li>
      <li><strong>Net tazminat</strong> = brüt tutardan yüzde {damgaYuzde} damga vergisi düşülür (başka kesinti yoktur).</li>
    </ul>
    <div class="example">
      <p>
        <strong>Örnek (tavan altı):</strong> {ornTarih} arası çalışan, aylık {formatInt(orn1Maas)} TL
        brüt maaşlı biri (çıkış 2026 ikinci yarısında). Çalışma süresi {formatInt(orn1.totalDays)} gündür.
      </p>
      <p>
        Maaş ({formatInt(orn1Maas)} TL), dönemin tavanının ({capH2Str} TL) altında olduğu için
        aynen kullanılır: Brüt = {formatInt(orn1Maas)} × {formatInt(orn1.totalDays)} / {yilGun} = {formatTL(orn1.grossAmount)} TL.
      </p>
      <p>Damga vergisi = {formatTL(orn1.grossAmount)} × yüzde {damgaYuzde} = {formatTL(orn1.stampTax)} TL.</p>
      <p class="result">Net kıdem tazminatı ≈ {formatTL(orn1.netAmount)} TL.</p>
    </div>
    <div class="example">
      <p>
        <strong>Örnek (tavan üstü):</strong> Aynı tarihler, ama aylık {formatInt(orn2Maas)} TL maaş.
        Maaş, tavanın ({capH2Str} TL) üzerinde olduğu için tavan kullanılır:
      </p>
      <p class="result">Brüt = {capH2Str} × {formatInt(orn2.totalDays)} / {yilGun} = {formatTL(orn2.grossAmount)} TL; net ≈ {formatTL(orn2.netAmount)} TL.</p>
    </div>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="kidem" />

  <Disclaimer />
</BaseLayout>

<script>
  // Hesap mantığı tek kaynakta: utils/calc-web.ts (mobil kidemTazminati ile birebir).
  // Kıdem tavanları constants/parameters.ts'ten gelir.
  import { calculateSeverance } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
  const fmtInt = (n) => new Intl.NumberFormat('tr-TR').format(n);

  function show(r) {
    document.getElementById('total-days').textContent =
      `${fmtInt(r.totalDays)} gün (≈ ${(Math.floor((r.totalDays / 365) * 10) / 10).toLocaleString('tr-TR')} yıl)`;
    document.getElementById('capped-annual').textContent =
      `TL ${fmt(r.cappedAnnual)}${r.ceilingApplied ? ' (tavan)' : ''}`;
    document.getElementById('gross-severance-amount').textContent = `TL ${fmt(r.grossAmount)}`;
    document.getElementById('stamp-severance').textContent = `-TL ${fmt(r.stampTax)}`;
    document.getElementById('net-severance').textContent = `TL ${fmt(r.netAmount)}`;
    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = `TL ${fmt(r.netAmount)}`;
  }

  function resetDisplay() {
    show({ totalDays: 0, cappedAnnual: 0, ceilingApplied: false, grossAmount: 0, stampTax: 0, netAmount: 0 });
  }

  function calculate() {
    const gross = parseFloat(document.getElementById('gross-severance').value) || 0;
    const entry = document.getElementById('entry-date-severance').value || '';
    const exit = document.getElementById('exit-date-severance').value || '';
    const note = document.getElementById('ceiling-note');

    if (gross <= 0 || !entry || !exit) {
      if (note) note.textContent = '';
      resetDisplay();
      return;
    }

    const r = calculateSeverance(entry, exit, gross);
    show(r);

    if (note) {
      if (r.totalDays < 0) {
        note.textContent = 'İşten çıkış tarihi, işe giriş tarihinden önce olamaz.';
      } else if (!r.entitled) {
        note.textContent = '1 yıldan (365 gün) az kıdemde tazminat hakkı doğmaz (İş Kanunu).';
      } else {
        note.textContent = `Bu tarih için geçerli kıdem tavanı: ${fmt(r.ceiling)} TL`;
      }
    }
  }

  function init() {
    const ids = ['gross-severance', 'entry-date-severance', 'exit-date-severance'];
    const inputs = ids.map((id) => document.getElementById(id));
    if (inputs.some((el) => !el)) {
      console.error('Kidem tazminati: input elemanlari bulunamadi');
      return;
    }
    inputs.forEach((el) => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });
    calculate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
