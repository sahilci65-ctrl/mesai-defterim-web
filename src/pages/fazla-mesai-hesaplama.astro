---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  WORKING_DAYS_PER_MONTH,
  OVERTIME_MULTIPLIER,
  STAMP_TAX_RATE,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const saatBolen = formatInt(WORKING_DAYS_PER_MONTH); // "225"
const carpan = OVERTIME_MULTIPLIER.toLocaleString('tr-TR'); // "1,5"
const artisYuzde = formatPercent(OVERTIME_MULTIPLIER - 1, 0); // "50"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"

// Açıklama için örnek hesap (parametrelerden türetilir)
const ornekMaas = 30000;
const ornekSaat = 10;
const ornekSaatlik = ornekMaas / WORKING_DAYS_PER_MONTH;
const ornekBrut = ornekSaatlik * ornekSaat * OVERTIME_MULTIPLIER;
const ornekDamga = ornekBrut * STAMP_TAX_RATE;
const ornekNet = ornekBrut - ornekDamga;

const faqItems = [
  {
    question: "Net maaşımı mı brüt maaşımı mı gireceğim?",
    answer: "Varsayılan olarak aylık NET maaşını (eline geçen tutarı) girmen yeterlidir; çoğu çalışan brütünü değil netini bilir. Araç, net maaşını önce tahmini brüte çevirir, fazla mesai hesabını mevzuat gereği brüt üzerinden yapar ve sonucu net olarak gösterir. Bordronu biliyorsan 'Brüt gireceğim' seçeneğiyle doğrudan brüt de girebilirsin.",
  },
  {
    question: "Fazla mesai nasıl hesaplanır?",
    answer: `Saatlik ücret = aylık brüt / ${saatBolen}. Fazla mesai ücreti = saatlik ücret × saat × ${carpan} (İş Kanunu m.41). Bulunan brüt tutardan yüzde ${damgaYuzde} damga vergisi düşülür.`,
  },
  {
    question: "İş Kanunu m.41 nedir?",
    answer: `İş Kanunu 41. madde, fazla çalışma ücretinin normal saat ücretinin en az yüzde ${artisYuzde} fazlasıyla ödeneceğini belirtir. Yani her fazla mesai saati için saatlik ücretin ${carpan} katı ödenmelidir.`,
  },
  {
    question: `Saatlik ücret neden aylık maaşın ${saatBolen}'e bölünmesiyle bulunuyor?`,
    answer: `Standart aylık çalışma süresi 30 gün × 7,5 saat = ${saatBolen} saat kabul edilir. Bu yüzden saatlik ücret, aylık brüt maaşın ${saatBolen}'e bölünmesiyle bulunur.`,
  },
  {
    question: "Gece çalışmasının veya bayram mesaisinin artışı dahil mi?",
    answer: "Bu hesaplayıcı standart fazla mesai ücretini gösterir. Gece çalışması, hafta tatili, resmi tatil ve bayram gibi özel durumların ek artışları için muhasebe uzmanına danışmanız önemlidir.",
  },
];

const relatedTools = [
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Net-Brüt Maaş",
    url: "/net-brut-maas-hesaplama",
    description: "Brüt ve net maaş arasında dönüşüm yap.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="Fazla Mesai Ücreti Hesaplama 2026 — Ücretsiz Online Araç"
  description="Aylık net maaşını ve fazla mesai saatini gir; İş Kanunu m.41'e göre 1,5 kat fazla mesai net ücretini 2026 değerleriyle anında, ücretsiz hesapla."
>
  <Calculator
    title="Fazla Mesai Ücreti Hesaplayıcı"
    description="Aylık net maaşını ve fazla mesai saatini gir, tahmini net ücretini anında öğren."
    resultLabel="Tahmini Fazla Mesai Net Ücreti:"
    resultValue="TL 0,00"
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label id="salary-mode-label-overtime">Maaş türü</label>
        <div class="salary-mode" role="radiogroup" aria-labelledby="salary-mode-label-overtime">
          <label class="mode-opt"><input type="radio" name="mode-overtime" value="net" checked /> Net maaş (elime geçen)</label>
          <label class="mode-opt"><input type="radio" name="mode-overtime" value="gross" /> Brüt gireceğim</label>
        </div>
      </div>
      <div>
        <label for="salary-overtime" id="salary-overtime-label">Aylık Net Maaş (elime geçen) (TL)</label><br />
        <input
          id="salary-overtime"
          type="number"
          placeholder="35000"
          min="0"
          step="100"
          value="35000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
        <small id="salary-overtime-gross-note" class="field-note"></small>
      </div>
      <div>
        <label for="hours-overtime">Fazla Mesai Saati</label><br />
        <input
          id="hours-overtime"
          type="number"
          placeholder="10"
          min="0"
          step="0.5"
          value="10"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Saatlik Ücret (brüt):</span>
          <strong id="hourly-rate">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Brüt Fazla Mesai:</span>
          <strong id="gross-amount">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Damga Vergisi:</span>
          <strong id="stamp-amount">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Net Fazla Mesai Ücreti:</span>
          <strong id="net-amount">TL 0,00</strong>
        </div>
      </div>

      <p id="convert-note-overtime" class="convert-note">Net-brüt dönüşümü tahminidir; kesin tutar bordro parametrelerine göre değişebilir.</p>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Fazla mesai ücreti, normal saatlik ücretinin en az <strong>yüzde {artisYuzde}</strong>
      fazlasıyla, yani <strong>{carpan} katı</strong> olarak ödenir (İş Kanunu m.41).
      Hesap üç adımda yapılır:
    </p>
    <ul>
      <li>
        <strong>Saatlik ücret</strong> = aylık brüt maaş / {saatBolen}.
        ({saatBolen} sayısı, 30 gün × 7,5 saatlik standart aylık çalışma süresidir.)
      </li>
      <li><strong>Brüt fazla mesai</strong> = saatlik ücret × fazla mesai saati × {carpan}.</li>
      <li><strong>Net ücret</strong> = brüt tutardan yüzde {damgaYuzde} damga vergisi düşülür.</li>
    </ul>
    <p>
      Girişte <strong>net maaşını</strong> (eline geçen tutarı) yazman yeterlidir; araç bunu
      önce tahmini brüte çevirir, hesabı mevzuat gereği brüt üzerinden yapar ve sonucu net
      olarak gösterir. Bordronu biliyorsan "Brüt gireceğim" seçeneğiyle doğrudan brüt girebilirsin.
    </p>
    <div class="example">
      <p>
        <strong>Örnek:</strong> Aylık {formatInt(ornekMaas)} TL brüt maaşlı biri, bir ayda
        {ornekSaat} saat fazla mesai yapmış olsun.
      </p>
      <p>Saatlik ücret = {formatInt(ornekMaas)} / {saatBolen} = {formatTL(ornekSaatlik)} TL.</p>
      <p>Brüt fazla mesai = {formatTL(ornekSaatlik)} × {ornekSaat} × {carpan} = {formatTL(ornekBrut)} TL.</p>
      <p>Damga vergisi = {formatTL(ornekBrut)} × yüzde {damgaYuzde} = {formatTL(ornekDamga)} TL.</p>
      <p class="result">Net fazla mesai ücreti ≈ {formatTL(ornekNet)} TL.</p>
    </div>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="fazla-mesai" />

  <Disclaimer />
</BaseLayout>

<script>
  import { calculateGrossFromNet, calculateOvertime } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

  function currentMode() {
    const checked = document.querySelector('input[name="mode-overtime"]:checked');
    return checked ? checked.value : 'net';
  }

  function resetDisplay() {
    document.getElementById('hourly-rate').textContent = 'TL 0,00';
    document.getElementById('gross-amount').textContent = 'TL 0,00';
    document.getElementById('stamp-amount').textContent = '-TL 0,00';
    document.getElementById('net-amount').textContent = 'TL 0,00';
    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = 'TL 0,00';
  }

  function recalc() {
    const salaryInput = document.getElementById('salary-overtime');
    const hoursInput = document.getElementById('hours-overtime');
    const salaryLabel = document.getElementById('salary-overtime-label');
    const grossNote = document.getElementById('salary-overtime-gross-note');
    const convertNote = document.getElementById('convert-note-overtime');

    const mode = currentMode();
    const raw = parseFloat(salaryInput.value) || 0;
    const hours = parseFloat(hoursInput.value) || 0;

    // Etiket ve not görünürlüğü
    salaryLabel.textContent = mode === 'net'
      ? 'Aylık Net Maaş (elime geçen) (TL)'
      : 'Aylık Brüt Maaş (TL)';
    convertNote.style.display = mode === 'net' ? 'block' : 'none';

    if (raw <= 0 || hours <= 0) {
      grossNote.textContent = '';
      resetDisplay();
      return;
    }

    // Net girildiyse önce tahmini brüte çevir (mevzuat brüt üzerinden hesaplar)
    let grossSalary = raw;
    if (mode === 'net') {
      grossSalary = calculateGrossFromNet(raw).gross;
      grossNote.textContent = `Tahmini aylık brüt: ${fmt(grossSalary)} TL`;
    } else {
      grossNote.textContent = '';
    }

    const r = calculateOvertime(grossSalary, hours);

    document.getElementById('hourly-rate').textContent = `TL ${fmt(r.hourlyRate)}`;
    document.getElementById('gross-amount').textContent = `TL ${fmt(r.grossAmount)}`;
    document.getElementById('stamp-amount').textContent = `-TL ${fmt(r.stampTax)}`;
    document.getElementById('net-amount').textContent = `TL ${fmt(r.netAmount)}`;

    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = `TL ${fmt(r.netAmount)}`;
  }

  function init() {
    const salaryInput = document.getElementById('salary-overtime');
    const hoursInput = document.getElementById('hours-overtime');
    if (!salaryInput || !hoursInput) {
      console.error('Fazla mesai: input elemanlari bulunamadi');
      return;
    }
    salaryInput.addEventListener('input', recalc);
    hoursInput.addEventListener('input', recalc);
    document.querySelectorAll('input[name="mode-overtime"]').forEach((el) => {
      el.addEventListener('change', recalc);
    });
    recalc();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .salary-mode {
    display: flex;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
  }

  .mode-opt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 400;
    font-size: 0.95rem;
    margin-bottom: 0;
    cursor: pointer;
    color: #1f2937;
    min-height: 44px;
  }

  .mode-opt input {
    width: auto;
    min-height: auto;
    margin: 0;
  }

  .field-note {
    display: block;
    margin-top: 0.35rem;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .convert-note {
    margin: 0;
    color: #6b7280;
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
