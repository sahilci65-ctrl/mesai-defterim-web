---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  YEAR,
  MINIMUM_WAGE,
  WORKING_DAYS_PER_MONTH,
  OVERTIME_MULTIPLIER,
  FAZLA_SURELER_ARTIS,
  STAMP_TAX_RATE,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';
import { calculateExtraPayNet } from '../utils/calc-web';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const saatBolen = formatInt(WORKING_DAYS_PER_MONTH); // "225"
const carpan = OVERTIME_MULTIPLIER.toLocaleString('tr-TR'); // "1,5"
const artisYuzde = formatPercent(OVERTIME_MULTIPLIER - 1, 0); // "50"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"

// Açıklama için örnek hesap (parametrelerden türetilir)
const ornekMaas = 30000;
const ornekSaat = 10;
const ornekSaatlik = ornekMaas / WORKING_DAYS_PER_MONTH;
const ornekBrut = ornekSaatlik * ornekSaat * OVERTIME_MULTIPLIER;
const ornekYaklasikNet = calculateExtraPayNet(ornekMaas, ornekBrut);

// SSS — sorular Google'da aranan ifadelerden seçildi (FAQPage şeması FAQ bileşeninde üretilir)
const asgariSaatlik = MINIMUM_WAGE / WORKING_DAYS_PER_MONTH;
const asgariBirSaat = asgariSaatlik * OVERTIME_MULTIPLIER;
const fazlaSurelerArtis = formatPercent(FAZLA_SURELER_ARTIS, 0); // "25"

const faqItems = [
  {
    question: "Fazla mesai ücreti nasıl hesaplanır?",
    answer: `Önce saatlik ücretini bulursun: aylık brüt maaş / ${saatBolen}. Sonra bunu fazla çalıştığın saatle ve ${carpan} ile çarparsın (İş Kanunu m.41). Örneğin brüt ${formatInt(ornekMaas)} TL maaşla ${ornekSaat} saat fazla mesai yaptıysan brüt ücretin yaklaşık ${formatTL(ornekBrut)} TL olur. Kendi rakamlarınla hesaplamak için yukarıdaki aracı kullanabilirsin; net maaşını girmen yeterli.`,
  },
  {
    question: "1 saat fazla mesai ne kadar?",
    answer: `1 saat fazla mesai = (aylık brüt / ${saatBolen}) × ${carpan}. ${YEAR} brüt asgari ücreti (${formatInt(MINIMUM_WAGE)} TL) ile çalışan biri için saatlik ücret ${formatTL(asgariSaatlik)} TL, 1 saat fazla mesai ise yaklaşık ${formatTL(asgariBirSaat)} TL brüttür. Maaşın daha yüksekse tutar da aynı oranda artar; yukarıdaki araca 1 saat yazarak kendi tutarını görebilirsin.`,
  },
  {
    question: "Fazla mesai yüzde kaç zamlı ödenir?",
    answer: `Haftalık 45 saati aşan her saat, normal saat ücretinin yüzde ${artisYuzde} fazlasıyla (${carpan} katı) ödenir. Sözleşmende haftalık süre 45 saatin altında belirlenmişse (ör. 40 saat), 40 ile 45 saat arasındaki çalışma "fazla sürelerle çalışma" sayılır ve yüzde ${fazlaSurelerArtis} zamlı ödenir. İşçi isterse ücret yerine her fazla saat için 1 saat 30 dakika serbest zaman da kullanabilir.`,
  },
  {
    question: "Haftalık kaç saati aşınca fazla mesai başlar?",
    answer: "Kanuni haftalık çalışma süresi en fazla 45 saattir; bunu aşan çalışma fazla mesaidir. Hesap günlük değil haftalık yapılır: bir gün 10 saat çalışıp başka bir gün erken çıktıysan haftalık toplam 45 saati geçmedikçe fazla mesai doğmaz. Taraflar anlaşırsa iki aylık denkleştirme de uygulanabilir. Fazla mesai için işçinin onayı gerekir ve yıllık toplamı 270 saati geçemez.",
  },
  {
    question: "Fazla mesai ücreti net mi brüt mü hesaplanır?",
    answer: `Fazla mesai ücreti kanunen brüt üzerinden hesaplanır ve maaşına eklenerek bordroya yazılır. Bu tutardan damga vergisinin yanında SGK primi ve gelir vergisi de kesilir. Yukarıdaki araç önce alman gereken brüt tutarı, altında da bu kesintilerin tamamı düşülmüş yaklaşık neti gösterir. Yıl içinde kümülatif vergi matrahın üst dilime geçmişse bordrondaki net biraz daha düşük olabilir.`,
  },
  {
    question: "Fazla mesaim ödenmezse ne yapabilirim?",
    answer: "Önce işverenden yazılı olarak (ör. e-posta veya noter yoluyla) ödeme iste. Sonuç alamazsan ALO 170'i arayabilir ya da Çalışma ve İş Kurumu il müdürlüğüne şikâyette bulunabilirsin. Dava açmadan önce arabulucuya başvurman zorunludur; ücret alacakları için zamanaşımı 5 yıldır. Ödenmeyen fazla mesai, işçiye iş sözleşmesini haklı nedenle feshedip kıdem tazminatı isteme hakkı da verebilir. Bu süreçte çalıştığın saatlerin kaydı (puantaj, mesajlar, tanıklar) en güçlü delilin olur.",
  },
  {
    question: "Net maaşımı mı brüt maaşımı mı gireceğim?",
    answer: "Varsayılan olarak aylık NET maaşını (eline geçen tutarı) girmen yeterlidir; çoğu çalışan brütünü değil netini bilir. Araç, net maaşını önce tahmini brüte çevirir, fazla mesai hesabını mevzuat gereği brüt üzerinden yapar. Bordronu biliyorsan 'Brüt gireceğim' seçeneğiyle doğrudan brüt de girebilirsin.",
  },
  {
    question: `Saatlik ücret neden aylık maaşın ${saatBolen}'e bölünmesiyle bulunuyor?`,
    answer: `Haftalık 45 saatlik çalışma, 6 güne bölündüğünde günde 7,5 saate denk gelir. Aylık ücret 30 gün üzerinden ödendiği için 30 × 7,5 = ${saatBolen} saat esas alınır ve saatlik ücret aylık brütün ${saatBolen}'e bölünmesiyle bulunur.`,
  },
];

const relatedTools = [
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama/",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama/",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Net-Brüt Maaş",
    url: "/net-brut-maas-hesaplama/",
    description: "Brüt ve net maaş arasında dönüşüm yap.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="Fazla Mesai Ücreti Hesaplama 2026 — Ücretsiz Online Araç"
  description="Aylık net maaşını ve fazla mesai saatini gir; İş Kanunu m.41'e göre 1,5 kat fazla mesai ücretini ve yaklaşık netini 2026 değerleriyle anında hesapla."
>
  <Calculator
    title="Fazla Mesai Ücreti Hesaplayıcı"
    description="Aylık net maaşını ve fazla mesai saatini gir, alman gereken fazla mesai ücretini anında öğren."
    resultLabel="Alman Gereken Fazla Mesai Ücreti (brüt):"
    resultValue="TL 0,00"
    showResultSub
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label id="salary-mode-label-overtime">Maaş türü</label>
        <div class="salary-mode" role="radiogroup" aria-labelledby="salary-mode-label-overtime">
          <label class="mode-opt"><input type="radio" name="mode-overtime" value="net" checked /> Net maaş (elime geçen)</label>
          <label class="mode-opt"><input type="radio" name="mode-overtime" value="gross" /> Brüt gireceğim</label>
        </div>
      </div>
      <div>
        <label for="salary-overtime" id="salary-overtime-label">Aylık Net Maaş (elime geçen) (TL)</label><br />
        <input
          id="salary-overtime"
          type="number"
          placeholder="35000"
          min="0"
          step="100"
          value="35000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
        <small id="salary-overtime-gross-note" class="field-note"></small>
      </div>
      <div>
        <label for="hours-overtime">Fazla Mesai Saati</label><br />
        <input
          id="hours-overtime"
          type="number"
          placeholder="10"
          min="0"
          step="0.5"
          value="10"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Saatlik Ücret (brüt):</span>
          <strong id="hourly-rate">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Alman Gereken (brüt):</span>
          <strong id="gross-amount">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-top: 0.5rem; color: #6b7280; font-size: 0.9rem;">
          <span>Yaklaşık net (tüm kesintiler sonrası):</span>
          <span id="approx-net-amount" style="white-space: nowrap; margin-left: 0.5rem;">TL 0,00</span>
        </div>
      </div>

      <p id="convert-note-overtime" class="convert-note">Net-brüt dönüşümü tahminidir; kesin tutar bordro parametrelerine göre değişebilir.</p>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Fazla mesai ücreti, normal saatlik ücretinin en az <strong>yüzde {artisYuzde}</strong>
      fazlasıyla, yani <strong>{carpan} katı</strong> olarak ödenir (İş Kanunu m.41).
      Hesap üç adımda yapılır:
    </p>
    <ul>
      <li>
        <strong>Saatlik ücret</strong> = aylık brüt maaş / {saatBolen}.
        ({saatBolen} sayısı, 30 gün × 7,5 saatlik standart aylık çalışma süresidir.)
      </li>
      <li><strong>Brüt fazla mesai</strong> = saatlik ücret × fazla mesai saati × {carpan}.</li>
      <li><strong>Yaklaşık net</strong>: Fazla mesai ücreti maaşına eklenerek bordroya girer; SGK ve işsizlik primi, gelir vergisi ve yüzde {damgaYuzde} damga vergisi kesilir. Araç bu kesintilerin tamamını düşerek yaklaşık neti de gösterir.</li>
    </ul>
    <p>
      Girişte <strong>net maaşını</strong> (eline geçen tutarı) yazman yeterlidir; araç bunu
      önce tahmini brüte çevirir ve hesabı mevzuat gereği brüt üzerinden yapar. Bordronu biliyorsan "Brüt gireceğim" seçeneğiyle doğrudan brüt girebilirsin.
    </p>
    <div class="example">
      <p>
        <strong>Örnek:</strong> Aylık {formatInt(ornekMaas)} TL brüt maaşlı biri, bir ayda
        {ornekSaat} saat fazla mesai yapmış olsun.
      </p>
      <p>Saatlik ücret = {formatInt(ornekMaas)} / {saatBolen} = {formatTL(ornekSaatlik)} TL.</p>
      <p>Brüt fazla mesai = {formatTL(ornekSaatlik)} × {ornekSaat} × {carpan} = {formatTL(ornekBrut)} TL.</p>
      <p class="result">Alman gereken fazla mesai ücreti ≈ {formatTL(ornekBrut)} TL (brüt).</p>
      <p>Maaşına eklendiğinde tüm kesintiler sonrası eline geçecek ek tutar ≈ {formatTL(ornekYaklasikNet)} TL.</p>
    </div>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="fazla-mesai" />

  <Disclaimer legalNote />
</BaseLayout>

<script>
  import { calculateGrossFromNet, calculateOvertime, calculateExtraPayNet } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

  function currentMode() {
    const checked = document.querySelector('input[name="mode-overtime"]:checked');
    return checked ? checked.value : 'net';
  }

  function resetDisplay() {
    document.getElementById('hourly-rate').textContent = 'TL 0,00';
    document.getElementById('gross-amount').textContent = 'TL 0,00';
    document.getElementById('approx-net-amount').textContent = 'TL 0,00';
    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = 'TL 0,00';
    const rs = document.getElementById('result-sub');
    if (rs) rs.textContent = '';
  }

  function recalc() {
    const salaryInput = document.getElementById('salary-overtime');
    const hoursInput = document.getElementById('hours-overtime');
    const salaryLabel = document.getElementById('salary-overtime-label');
    const grossNote = document.getElementById('salary-overtime-gross-note');
    const convertNote = document.getElementById('convert-note-overtime');

    const mode = currentMode();
    const raw = parseFloat(salaryInput.value) || 0;
    const hours = parseFloat(hoursInput.value) || 0;

    // Etiket ve not görünürlüğü
    salaryLabel.textContent = mode === 'net'
      ? 'Aylık Net Maaş (elime geçen) (TL)'
      : 'Aylık Brüt Maaş (TL)';
    convertNote.style.display = mode === 'net' ? 'block' : 'none';

    if (raw <= 0 || hours <= 0) {
      grossNote.textContent = '';
      resetDisplay();
      return;
    }

    // Net girildiyse önce tahmini brüte çevir (mevzuat brüt üzerinden hesaplar)
    let grossSalary = raw;
    if (mode === 'net') {
      grossSalary = calculateGrossFromNet(raw).gross;
      grossNote.textContent = `Tahmini aylık brüt: ${fmt(grossSalary)} TL`;
    } else {
      grossNote.textContent = '';
    }

    const r = calculateOvertime(grossSalary, hours);

    document.getElementById('hourly-rate').textContent = `TL ${fmt(r.hourlyRate)}`;
    // Mobil ile ayni: buyuk sonuc alman gereken BRUT, altinda tam kesintili yaklasik net
    const approxNet = calculateExtraPayNet(grossSalary, r.grossAmount);
    document.getElementById('gross-amount').textContent = `TL ${fmt(r.grossAmount)}`;
    document.getElementById('approx-net-amount').textContent = `TL ${fmt(approxNet)}`;

    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = `TL ${fmt(r.grossAmount)}`;
    const rs = document.getElementById('result-sub');
    if (rs) rs.textContent = `yaklaşık net: TL ${fmt(approxNet)}`;
  }

  function init() {
    const salaryInput = document.getElementById('salary-overtime');
    const hoursInput = document.getElementById('hours-overtime');
    if (!salaryInput || !hoursInput) {
      console.error('Fazla mesai: input elemanlari bulunamadi');
      return;
    }
    salaryInput.addEventListener('input', recalc);
    hoursInput.addEventListener('input', recalc);
    document.querySelectorAll('input[name="mode-overtime"]').forEach((el) => {
      el.addEventListener('change', recalc);
    });
    recalc();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .salary-mode {
    display: flex;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
  }

  .mode-opt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 400;
    font-size: 0.95rem;
    margin-bottom: 0;
    cursor: pointer;
    color: #1f2937;
    min-height: 44px;
  }

  .mode-opt input {
    width: auto;
    min-height: auto;
    margin: 0;
  }

  .field-note {
    display: block;
    margin-top: 0.35rem;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .convert-note {
    margin: 0;
    color: #6b7280;
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
