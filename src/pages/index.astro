---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';

const calculators = [
  {
    title: "Fazla Mesai Ücreti",
    description: "Ayda kaç saat fazla mesai yaptığını ve brüt maaşını gir, ek ücretini anında hesapla.",
    url: "/fazla-mesai-hesaplama/",
    icon: "⏰",
  },
  {
    title: "Kıdem Tazminatı",
    description: "İş yerinden ayrılırken alacağın kıdem tazminatını kıdem sürene göre hesapla.",
    url: "/kidem-tazminati-hesaplama/",
    icon: "📋",
  },
  {
    title: "İhbar Tazminatı",
    description: "Kıdem süresine göre belirlenen ihbar tazminatını anında hesapla.",
    url: "/ihbar-tazminati-hesaplama/",
    icon: "📢",
  },
  {
    title: "Net-Brüt Maaş",
    description: "Brüt ve net maaş arasında iki yönlü dönüşüm yap, tüm kesintileri gör.",
    url: "/net-brut-maas-hesaplama/",
    icon: "💰",
  },
  {
    title: "Resmi Tatil Mesaisi",
    description: "Resmi tatilde çalışmanın karşılığında alacağın ek ücreti hesapla.",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    icon: "🎉",
  },
];
---

<BaseLayout
  title="Mesai Defterim — Kıdem, İhbar, Maaş ve Mesai Hesaplama 2026"
  description="Kıdem ve ihbar tazminatı, net-brüt maaş, fazla mesai ve resmi tatil ücretini 2026 değerleriyle ücretsiz, anında ve tarayıcında gizli hesapla."
>
  <!-- Üst Bilgi -->
  <section class="hero">
    <div class="hero-container">
      <h1>Ücret Hesaplama Araçları</h1>
      <p>
        Mesai Defterim web hesaplayıcıları, Türk iş yasalarının en güncel
        parametrelerine göre hazırlanmıştır. Tüm hesaplamalar anında, ücretsiz
        ve gizlidir (verileriniz sunucuya gitmez).
      </p>
    </div>
  </section>

  <!-- Hesaplayıcı Kartları -->
  <section class="calculators-section">
    <div class="calculators-container">
      <h2>Ücretsiz Hesaplama Araçları (2026)</h2>
      <div class="calculators-grid">
        {
          calculators.map((calc) => (
            <a href={calc.url} class="calculator-card">
              <div class="card-icon">{calc.icon}</div>
              <h3>{calc.title}</h3>
              <p>{calc.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Uygulama Tanıtımı -->
  <AppBox campaignName="footer" />

  <!-- Bağımsızlık Beyanı -->
  <Disclaimer />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: var(--space-3xl) var(--space-md);
    text-align: center;
  }

  .hero-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: var(--font-size-4xl);
    color: white;
    margin-bottom: var(--space-lg);
  }

  .hero p {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.95);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .calculators-section {
    padding: var(--space-3xl) var(--space-md);
    background-color: var(--color-background);
  }

  .calculators-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .calculators-container h2 {
    font-size: var(--font-size-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .calculators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .calculator-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    text-decoration: none;
    color: inherit;
    min-height: 220px;
    cursor: pointer;
  }

  .calculator-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 61, 122, 0.12);
    transform: translateY(-4px);
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: var(--space-md);
  }

  .calculator-card h3 {
    font-size: var(--font-size-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    margin-top: 0;
  }

  .calculator-card p {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    flex-grow: 1;
    margin-bottom: 0;
    line-height: var(--line-height-normal);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: var(--font-size-3xl);
    }

    .hero p {
      font-size: var(--font-size-base);
    }

    .calculators-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
