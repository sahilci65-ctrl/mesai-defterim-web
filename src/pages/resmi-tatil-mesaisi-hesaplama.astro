---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { YEAR, MINIMUM_WAGE, DAYS_PER_MONTH_CALCULATION, STAMP_TAX_RATE } from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';
import { calculateExtraPayNet } from '../utils/calc-web';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const gunBolen = formatInt(DAYS_PER_MONTH_CALCULATION); // "30"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"

// Açıklama için örnek hesap: 30.000 TL, 3 gün resmi tatil çalışması
const ornMaas = 30000;
const ornGun = 3;
const ornGunluk = ornMaas / DAYS_PER_MONTH_CALCULATION;
const ornBrut = ornGunluk * ornGun;
const ornYaklasikNet = calculateExtraPayNet(ornMaas, ornBrut);

// SSS — sorular Google'da aranan ifadelerden seçildi (FAQPage şeması FAQ bileşeninde üretilir)
const asgariGunluk = MINIMUM_WAGE / DAYS_PER_MONTH_CALCULATION;

const faqItems = [
  {
    question: "Resmi tatilde çalışan işçi ne kadar alır?",
    answer: `Resmi tatilde çalışan işçi, o günün normal ücretine ek olarak bir günlük ücret daha alır (İş Kanunu m.47). Günlük ücret aylık brüt maaşın ${gunBolen}'a bölünmesiyle bulunur. Örneğin brüt ${formatInt(ornMaas)} TL maaşla ${ornGun} gün resmi tatilde çalışan biri, maaşının üstüne yaklaşık ${formatTL(ornBrut)} TL brüt ek ücret almalıdır. Kendi tutarını görmek için yukarıdaki aracı kullanabilirsin.`,
  },
  {
    question: "Asgari ücretli resmi tatilde çalışırsa ne alır?",
    answer: `${YEAR} brüt asgari ücreti ${formatInt(MINIMUM_WAGE)} TL'dir; günlük brüt ücret ${formatInt(MINIMUM_WAGE)} / ${gunBolen} = ${formatTL(asgariGunluk)} TL eder. Asgari ücretli bir işçi resmi tatilde çalıştığı her gün için maaşına ek olarak ${formatTL(asgariGunluk)} TL brüt alır. Örneğin 3,5 günlük bir bayramın tamamında çalışırsa ek ücreti ${formatTL(asgariGunluk * 3.5)} TL brüt olur. Bu tutardan yasal kesintiler yapılır.`,
  },
  {
    question: "Resmi tatil ücreti kaç kat ödenir?",
    answer: "Halk arasında \"çift yevmiye\" denir: resmi tatilde çalışılan gün için toplam 2 günlük ücret ödenir. Bunun 1 günü zaten aylık maaşının içindedir (çalışmasan da alırdın), diğer 1 günü çalıştığın için eklenen ücrettir. Yani bordronda maaşına ek olarak görmen gereken, çalıştığın her gün için 1 günlük ücrettir. Toplu sözleşme veya iş sözleşmesiyle daha yüksek bir oran belirlenmişse o uygulanır.",
  },
  {
    question: "Hangi günler resmi tatil sayılır?",
    answer: "1 Ocak Yılbaşı, 23 Nisan, 1 Mayıs, 19 Mayıs, 15 Temmuz, 30 Ağustos ve 29 Ekim (28 Ekim öğleden sonrasıyla birlikte 1,5 gün) ulusal bayram ve genel tatildir. Bunlara arife günü öğleden sonrası dahil 3,5 günlük Ramazan Bayramı ve 4,5 günlük Kurban Bayramı eklenir. Dini bayramların tarihleri her yıl yaklaşık 11 gün öne kayar. Hükümetin ilan ettiği idari izinler resmi tatil sayılmaz; özel sektörde bu günlerde çalışmak ek ücret doğurmaz.",
  },
  {
    question: "Resmi tatilde çalışmak zorunlu mu?",
    answer: "Resmi tatilde çalışılıp çalışılmayacağı iş sözleşmesi veya toplu iş sözleşmesiyle belirlenir (İş Kanunu m.44). Sözleşmende bu konuda bir hüküm yoksa işveren seni resmi tatilde çalışmaya zorlayamaz, onayını alması gerekir. Hastane, güvenlik veya kesintisiz üretim gibi işin niteliği gereği sürekli çalışılan yerlerde ise bu genellikle baştan sözleşmede yer alır. Her durumda resmi tatilde çalıştığın günün ek ücreti ödenmelidir.",
  },
  {
    question: "Resmi tatil ücreti ödenmezse ne yapılır?",
    answer: "Önce bordrona bak: resmi tatil ücreti ayrı bir kalem olarak görünmelidir. Ödenmemişse işverenden yazılı olarak iste. Sonuç alamazsan ALO 170'i arayabilir veya Çalışma ve İş Kurumu il müdürlüğüne şikâyette bulunabilirsin. Dava yoluna gitmeden önce arabulucuya başvurmak zorunludur; bu alacak için zamanaşımı 5 yıldır. Hangi resmi tatillerde çalıştığını gösteren kayıtlar (puantaj, vardiya listesi, mesajlar) hakkını ispatlamanı kolaylaştırır.",
  },
  {
    question: "Net maaşımı mı brüt maaşımı mı gireceğim?",
    answer: "Varsayılan olarak aylık NET maaşını (eline geçen tutarı) girmen yeterlidir; çoğu çalışan brütünü değil netini bilir. Araç, net maaşını önce tahmini brüte çevirir ve resmi tatil ek ücretini mevzuat gereği brüt üzerinden hesaplar. Bordronu biliyorsan 'Brüt gireceğim' seçeneğiyle doğrudan brüt de girebilirsin.",
  },
  {
    question: "Resmi tatil ücretinden kesinti yapılır mı?",
    answer: `Evet. Resmi tatil ek ücreti maaşa eklenerek bordroya yazılır; yüzde ${damgaYuzde} damga vergisinin yanında SGK primi ve gelir vergisi de kesilir. Yukarıdaki araç önce alman gereken brüt tutarı, altında da bu kesintilerin tamamı düşülmüş yaklaşık neti gösterir. Yıl içinde kümülatif vergi matrahın üst dilime geçmişse bordrondaki net biraz daha düşük olabilir.`,
  },
];

const relatedTools = [
  {
    title: "Fazla Mesai Ücreti",
    url: "/fazla-mesai-hesaplama/",
    description: "Ayda kaç saat fazla mesai yaptıysan ücretini hesapla.",
  },
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama/",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama/",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Net-Brüt Maaş",
    url: "/net-brut-maas-hesaplama/",
    description: "Brüt ve net maaş arasında dönüşüm yap.",
  },
];
---

<BaseLayout
  title="Resmi Tatil Mesaisi Ücreti Hesaplama 2026 — Ücretsiz Araç"
  description="Aylık net maaşını ve çalıştığın resmi tatil gün sayısını gir; resmi tatil mesaisi ek ücretini ve yaklaşık netini 2026 değerleriyle anında hesapla."
>
  <Calculator
    title="Resmi Tatil Mesaisi Hesaplayıcı"
    description="Aylık net maaşını ve çalışılan resmi tatil günü sayısını gir, alman gereken ek ücreti anında öğren."
    resultLabel="Alman Gereken Resmi Tatil Ücreti (brüt):"
    resultValue="TL 0,00"
    showResultSub
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label id="salary-mode-label-holiday">Maaş türü</label>
        <div class="salary-mode" role="radiogroup" aria-labelledby="salary-mode-label-holiday">
          <label class="mode-opt"><input type="radio" name="mode-holiday" value="net" checked /> Net maaş (elime geçen)</label>
          <label class="mode-opt"><input type="radio" name="mode-holiday" value="gross" /> Brüt gireceğim</label>
        </div>
      </div>
      <div>
        <label for="salary-holiday" id="salary-holiday-label">Aylık Net Maaş (elime geçen) (TL)</label><br />
        <input
          id="salary-holiday"
          type="number"
          placeholder="35000"
          min="0"
          step="100"
          value="35000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
        <small id="salary-holiday-gross-note" class="field-note"></small>
      </div>

      <div>
        <label for="days-holiday">Çalışılan Resmi Tatil Günü Sayısı</label><br />
        <input
          id="days-holiday"
          type="number"
          placeholder="3"
          min="0"
          step="0.5"
          value="1"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Günlük Ücret (brüt):</span>
          <strong id="daily-rate-holiday">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Alman Gereken (brüt):</span>
          <strong id="gross-holiday-amount">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-top: 0.5rem; color: #6b7280; font-size: 0.9rem;">
          <span>Yaklaşık net (tüm kesintiler sonrası):</span>
          <span id="approx-net-holiday" style="white-space: nowrap; margin-left: 0.5rem;">TL 0,00</span>
        </div>
      </div>

      <p id="convert-note-holiday" class="convert-note">Net-brüt dönüşümü tahminidir; kesin tutar bordro parametrelerine göre değişebilir.</p>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Resmi tatil, çalışılmasa bile ücreti ödenen bir gündür. Bu günde
      çalışıldığında, normal ücrete <strong>ek olarak 1 günlük ücret</strong> daha
      ödenir (günlük ücretin yüzde 100'ü). Hesap şöyle yapılır:
    </p>
    <ul>
      <li><strong>Günlük ücret</strong> = aylık brüt maaş / {gunBolen}.</li>
      <li><strong>Alman gereken ek ücret (brüt)</strong> = günlük ücret × çalışılan resmi tatil günü sayısı.</li>
      <li><strong>Yaklaşık net</strong>: Ek ücret maaşına eklenerek bordroya girer; SGK ve işsizlik primi, gelir vergisi ve yüzde {damgaYuzde} damga vergisi kesilir. Araç bu kesintilerin tamamını düşerek yaklaşık neti de gösterir.</li>
    </ul>
    <p>
      Girişte <strong>net maaşını</strong> (eline geçen tutarı) yazman yeterlidir; araç bunu
      önce tahmini brüte çevirir ve ek ücreti mevzuat gereği brüt üzerinden hesaplar. Bordronu biliyorsan "Brüt gireceğim" seçeneğiyle doğrudan brüt girebilirsin.
    </p>
    <div class="example">
      <p>
        <strong>Örnek:</strong> Aylık {formatInt(ornMaas)} TL brüt maaşlı biri,
        {ornGun} gün resmi tatilde çalışmış olsun.
      </p>
      <p>Günlük ücret = {formatInt(ornMaas)} / {gunBolen} = {formatTL(ornGunluk)} TL.</p>
      <p class="result">Alman gereken ek ücret = {formatTL(ornGunluk)} × {ornGun} = {formatTL(ornBrut)} TL (brüt).</p>
      <p>Maaşına eklendiğinde tüm kesintiler sonrası eline geçecek ek tutar ≈ {formatTL(ornYaklasikNet)} TL.</p>
    </div>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="resmi-tatil" />

  <Disclaimer legalNote />
</BaseLayout>

<script>
  import { calculateGrossFromNet, calculatePublicHolidayWork, calculateExtraPayNet } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

  function currentMode() {
    const checked = document.querySelector('input[name="mode-holiday"]:checked');
    return checked ? checked.value : 'net';
  }

  function resetDisplay() {
    document.getElementById('daily-rate-holiday').textContent = 'TL 0,00';
    document.getElementById('gross-holiday-amount').textContent = 'TL 0,00';
    document.getElementById('approx-net-holiday').textContent = 'TL 0,00';
    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = 'TL 0,00';
    const rs = document.getElementById('result-sub');
    if (rs) rs.textContent = '';
  }

  function recalc() {
    const salaryInput = document.getElementById('salary-holiday');
    const daysInput = document.getElementById('days-holiday');
    const salaryLabel = document.getElementById('salary-holiday-label');
    const grossNote = document.getElementById('salary-holiday-gross-note');
    const convertNote = document.getElementById('convert-note-holiday');

    const mode = currentMode();
    const raw = parseFloat(salaryInput.value) || 0;
    const days = parseFloat(daysInput.value) || 0;

    // Etiket ve not görünürlüğü
    salaryLabel.textContent = mode === 'net'
      ? 'Aylık Net Maaş (elime geçen) (TL)'
      : 'Aylık Brüt Maaş (TL)';
    convertNote.style.display = mode === 'net' ? 'block' : 'none';

    if (raw <= 0 || days <= 0) {
      grossNote.textContent = '';
      resetDisplay();
      return;
    }

    // Net girildiyse önce tahmini brüte çevir (mevzuat brüt üzerinden hesaplar)
    let grossSalary = raw;
    if (mode === 'net') {
      grossSalary = calculateGrossFromNet(raw).gross;
      grossNote.textContent = `Tahmini aylık brüt: ${fmt(grossSalary)} TL`;
    } else {
      grossNote.textContent = '';
    }

    const r = calculatePublicHolidayWork(grossSalary, days);

    document.getElementById('daily-rate-holiday').textContent = `TL ${fmt(r.dailyRate)}`;
    // Mobil ile ayni: buyuk sonuc alman gereken BRUT, altinda tam kesintili yaklasik net
    const approxNet = calculateExtraPayNet(grossSalary, r.grossAmount);
    document.getElementById('gross-holiday-amount').textContent = `TL ${fmt(r.grossAmount)}`;
    document.getElementById('approx-net-holiday').textContent = `TL ${fmt(approxNet)}`;

    const rv = document.getElementById('result-value');
    if (rv) rv.textContent = `TL ${fmt(r.grossAmount)}`;
    const rs = document.getElementById('result-sub');
    if (rs) rs.textContent = `yaklaşık net: TL ${fmt(approxNet)}`;
  }

  function init() {
    const salaryInput = document.getElementById('salary-holiday');
    const daysInput = document.getElementById('days-holiday');
    if (!salaryInput || !daysInput) {
      console.error('Resmi tatil: input elemanlari bulunamadi');
      return;
    }
    salaryInput.addEventListener('input', recalc);
    daysInput.addEventListener('input', recalc);
    document.querySelectorAll('input[name="mode-holiday"]').forEach((el) => {
      el.addEventListener('change', recalc);
    });
    recalc();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .salary-mode {
    display: flex;
    gap: 0.5rem 1.25rem;
    flex-wrap: wrap;
  }

  .mode-opt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 400;
    font-size: 0.95rem;
    margin-bottom: 0;
    cursor: pointer;
    color: #1f2937;
    min-height: 44px;
  }

  .mode-opt input {
    width: auto;
    min-height: auto;
    margin: 0;
  }

  .field-note {
    display: block;
    margin-top: 0.35rem;
    color: #6b7280;
    font-size: 0.85rem;
  }

  .convert-note {
    margin: 0;
    color: #6b7280;
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
