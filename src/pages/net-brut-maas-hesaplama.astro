---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  MINIMUM_WAGE,
  SGK_RATES,
  TAX_BRACKETS,
  STAMP_TAX_RATE,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const minWageStr = formatInt(MINIMUM_WAGE); // "16.500"
const sgkYuzde = formatPercent(SGK_RATES.total, 0); // "15"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"
const ilkDilimYuzde = formatPercent(TAX_BRACKETS[0].rate, 0); // "15"

// Vergi dilimleri açıklaması — doğrudan parametrelerden üretilir
const dilimAcik = TAX_BRACKETS.map((b, i) => {
  const oran = formatPercent(b.rate, 0);
  const altStr = i === 0 ? '0' : formatInt(TAX_BRACKETS[i - 1].limit + 1);
  if (!isFinite(b.limit)) {
    return `${altStr} TL ve üzeri yüzde ${oran}`;
  }
  return `${altStr} - ${formatInt(b.limit)} TL arası yüzde ${oran}`;
}).join('; ');

// Açıklama için örnek hesap: 30.000 TL brüt (sayfadaki hesaplayıcıyla aynı mantık)
const ornBrut = 30000;
const ornSgk = ornBrut > MINIMUM_WAGE ? (ornBrut - MINIMUM_WAGE) * SGK_RATES.total : 0;
const ornMatrah = ornBrut - ornSgk;
const ornVergi = ornMatrah * TAX_BRACKETS[0].rate; // matrah ilk dilimde
const ornDamga = ornBrut * STAMP_TAX_RATE;
const ornNet = ornBrut - ornSgk - ornVergi - ornDamga;

const faqItems = [
  {
    question: "Brüt ve net maaş farkı nedir?",
    answer: `Brüt maaş, kesintiler yapılmadan önceki toplam maaşınızdır. Net maaş ise SGK işçi payı (yüzde ${sgkYuzde}), gelir vergisi ve damga vergisi (yüzde ${damgaYuzde}) kesildikten sonra elinize geçen tutardır.`,
  },
  {
    question: "Asgari ücret istisnası nedir?",
    answer: `Asgari ücrete kadar olan kısım kesinti/istisna kapsamındadır. Bu hesaplayıcıda asgari ücret ${minWageStr} TL alınır; bu tutara kadarki kısım için SGK kesintisi uygulanmaz, aşan kısım üzerinden hesap yapılır.`,
  },
  {
    question: "2026 gelir vergisi dilimleri nelerdir?",
    answer: `2026 gelir vergisi dilimleri: ${dilimAcik}. Vergi, kümülatif matraha göre dilim dilim uygulanır.`,
  },
  {
    question: "Brüt artınca net neden daha az artıyor?",
    answer: "Brüt arttığında hem SGK primi hem de gelir vergisi artar; ayrıca gelir bir üst vergi dilimine geçebilir. Bu nedenle brüt maaştaki artışın tamamı nete yansımaz.",
  },
  {
    question: "Sonuç kesin mi?",
    answer: "Hayır, tahminidir. Gerçek bordro; yıl içinde biriken kümülatif vergi matrahı, asgari ücret gelir vergisi istisnası ve iş yerine özgü kesintilerle muhasebe tarafından hesaplanır. Bu araç, kümülatif matrahı basitleştirerek yaklaşık bir sonuç verir.",
  },
];

const relatedTools = [
  {
    title: "Fazla Mesai Ücreti",
    url: "/fazla-mesai-hesaplama/",
    description: "Ayda kaç saat fazla mesai yaptıysan ücretini hesapla.",
  },
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama/",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama/",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="Net-Brüt Maaş Hesaplama 2026 — Ücretsiz Online Çevirici"
  description="Brütten nete, netten brüte çevir. 2026 gelir vergisi dilimleri, SGK primi ve damga vergisiyle net maaşını anında, ücretsiz ve gizli hesapla."
>
  <Calculator
    title="Net-Brüt Maaş Çevirici"
    description="Brüt veya net maaşını gir, diğer tutar tüm kesintileriyle birlikte otomatik hesaplansın."
    resultLabel="Net Maaşın:"
    resultValue="TL 0,00"
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label for="gross-netbrut">Aylık Brüt Maaş (TL)</label><br />
        <input
          id="gross-netbrut"
          type="number"
          placeholder="45000"
          min="0"
          step="100"
          value="45000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div>
        <label for="net-netbrut">VEYA Aylık Net Maaş (TL)</label><br />
        <input
          id="net-netbrut"
          type="number"
          placeholder="0"
          min="0"
          step="100"
          value="0"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Brüt Maaş:</span>
          <strong id="display-gross">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>SGK Kesintisi:</span>
          <strong id="display-sgk">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Gelir Vergisi:</span>
          <strong id="display-tax">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Damga Vergisi (yüzde 0,759):</span>
          <strong id="display-stamp">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Net Maaş:</span>
          <strong id="display-net">TL 0,00</strong>
        </div>
      </div>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Net maaş, brüt maaştan üç kalemin düşülmesiyle bulunur. Hesaplayıcı bunu
      hem brütten nete hem de netten brüte doğru yapar. Kesintiler:
    </p>
    <ul>
      <li><strong>SGK işçi payı (yüzde {sgkYuzde}):</strong> Asgari ücrete ({minWageStr} TL) isabet eden kısım istisna tutularak, aşan tutar üzerinden hesaplanır.</li>
      <li><strong>Gelir vergisi:</strong> SGK sonrası kalan matraha, dilimlere göre uygulanır (ilk dilim yüzde {ilkDilimYuzde}).</li>
      <li><strong>Damga vergisi (yüzde {damgaYuzde}):</strong> Brüt maaş üzerinden alınır.</li>
    </ul>
    <div class="example">
      <p><strong>Örnek:</strong> Aylık {formatInt(ornBrut)} TL brüt maaş.</p>
      <p>SGK = ({formatInt(ornBrut)} − {minWageStr}) × yüzde {sgkYuzde} = {formatTL(ornSgk)} TL.</p>
      <p>Gelir vergisi = {formatTL(ornMatrah)} × yüzde {ilkDilimYuzde} = {formatTL(ornVergi)} TL.</p>
      <p>Damga vergisi = {formatInt(ornBrut)} × yüzde {damgaYuzde} = {formatTL(ornDamga)} TL.</p>
      <p class="result">Net maaş ≈ {formatTL(ornNet)} TL.</p>
    </div>
    <p>
      Not: Gerçek bordroda vergi, yıl boyunca biriken <strong>kümülatif matraha</strong>
      göre arttığı için aylar ilerledikçe net maaş bir miktar düşebilir. Bu araç
      kümülatif matrahı basitleştirdiğinden sonuç yaklaşıktır.
    </p>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="net-brut" />

  <Disclaimer />
</BaseLayout>

<script>
  const TAX_BRACKETS = [
    { limit: 95000, rate: 0.15 },
    { limit: 540000, rate: 0.2 },
    { limit: 1800000, rate: 0.27 },
    { limit: Infinity, rate: 0.35 },
  ];

  const SGK_RATE = 0.15;
  const STAMP_TAX_RATE = 0.00759;
  const MINIMUM_WAGE = 16500;

  function calculateIncomeTax(grossIncome) {
    const sgkDeduction = calculateSGKDeduction(grossIncome);
    const taxableIncome = grossIncome - sgkDeduction;

    if (taxableIncome <= 0) return 0;

    let tax = 0;
    let previousLimit = 0;

    for (const bracket of TAX_BRACKETS) {
      if (taxableIncome <= previousLimit) break;

      const incomeInBracket = Math.min(taxableIncome, bracket.limit) - previousLimit;
      tax += incomeInBracket * bracket.rate;
      previousLimit = bracket.limit;
    }

    return Math.round(tax * 100) / 100;
  }

  function calculateSGKDeduction(grossIncome) {
    if (grossIncome <= MINIMUM_WAGE) {
      return 0;
    }

    const sgkBase = grossIncome - MINIMUM_WAGE;
    return Math.round(sgkBase * SGK_RATE * 100) / 100;
  }

  function calculateNetFromGross(gross) {
    const sgkDeduction = calculateSGKDeduction(gross);
    const incomeTax = calculateIncomeTax(gross);
    const stampTax = Math.round(gross * STAMP_TAX_RATE * 100) / 100;
    const net = Math.round((gross - sgkDeduction - incomeTax - stampTax) * 100) / 100;

    return {
      gross: Math.round(gross * 100) / 100,
      sgkDeduction,
      incomeTax,
      stampTax,
      net: Math.max(net, 0),
    };
  }

  function calculateGrossFromNet(net) {
    let low = net;
    let high = net * 2;
    let gross = net;

    for (let i = 0; i < 50; i++) {
      gross = (low + high) / 2;
      const result = calculateNetFromGross(gross);

      if (Math.abs(result.net - net) < 0.01) {
        break;
      }

      if (result.net < net) {
        low = gross;
      } else {
        high = gross;
      }
    }

    return calculateNetFromGross(gross);
  }

  function fmt(n) {
    return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
  }

  function displayResult(result) {
    document.getElementById('display-gross').textContent = `TL ${fmt(result.gross)}`;
    document.getElementById('display-sgk').textContent = `-TL ${fmt(result.sgkDeduction)}`;
    document.getElementById('display-tax').textContent = `-TL ${fmt(result.incomeTax)}`;
    document.getElementById('display-stamp').textContent = `-TL ${fmt(result.stampTax)}`;
    document.getElementById('display-net').textContent = `TL ${fmt(result.net)}`;

    // Calculator bileşenini güncelle
    const resultValue = document.getElementById('result-value');
    if (resultValue) resultValue.textContent = `TL ${fmt(result.net)}`;
  }

  function calculateFromGross() {
    const gross = parseFloat(document.getElementById('gross-netbrut').value) || 0;

    if (gross < 0) {
      displayResult({ gross: 0, sgkDeduction: 0, incomeTax: 0, stampTax: 0, net: 0 });
      return;
    }

    const result = calculateNetFromGross(gross);
    displayResult(result);

    // Net inputu güncelle (sync)
    document.getElementById('net-netbrut').value = result.net;
  }

  function calculateFromNet() {
    const net = parseFloat(document.getElementById('net-netbrut').value) || 0;

    if (net < 0) {
      displayResult({ gross: 0, sgkDeduction: 0, incomeTax: 0, stampTax: 0, net: 0 });
      return;
    }

    if (net === 0) {
      displayResult({ gross: 0, sgkDeduction: 0, incomeTax: 0, stampTax: 0, net: 0 });
      document.getElementById('gross-netbrut').value = 0;
      return;
    }

    const result = calculateGrossFromNet(net);
    displayResult(result);

    // Brüt inputu güncelle (sync)
    document.getElementById('gross-netbrut').value = result.gross;
  }

  function init() {
    const grossInput = document.getElementById('gross-netbrut');
    const netInput = document.getElementById('net-netbrut');

    if (!grossInput || !netInput) {
      console.error('Net-brut: input elemanlari bulunamadi');
      return;
    }

    grossInput.addEventListener('input', calculateFromGross);
    netInput.addEventListener('input', calculateFromNet);

    // Initial calculation
    calculateFromGross();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
