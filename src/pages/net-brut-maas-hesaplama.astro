---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Explanation from '../components/Explanation.astro';
import FAQ from '../components/FAQ.astro';
import AppBox from '../components/AppBox.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedTools from '../components/RelatedTools.astro';
import {
  YEAR,
  MINIMUM_WAGE,
  SGK_RATES,
  TAX_BRACKETS,
  STAMP_TAX_RATE,
} from '../constants/parameters';
import { formatTL, formatInt, formatPercent } from '../utils/format';
import { calculateNetFromGross } from '../utils/calc-web';

// 2026 parametreleri (tek kaynak: constants/parameters.ts)
const minWageStr = formatInt(MINIMUM_WAGE);
const sgkYuzde = formatPercent(SGK_RATES.employee, 0); // "14"
const issizlikYuzde = formatPercent(SGK_RATES.unemployment, 0); // "1"
const damgaYuzde = formatPercent(STAMP_TAX_RATE); // "0,759"
const ilkDilimYuzde = formatPercent(TAX_BRACKETS[0].rate, 0); // "15"
const asgariNet = calculateNetFromGross(MINIMUM_WAGE).net;

// Vergi dilimleri açıklaması — doğrudan parametrelerden üretilir
const dilimAcik = TAX_BRACKETS.map((b, i) => {
  const oran = formatPercent(b.rate, 0);
  const altStr = i === 0 ? '0' : formatInt(TAX_BRACKETS[i - 1].limit + 1);
  if (!isFinite(b.limit)) {
    return `${altStr} TL ve üzeri yüzde ${oran}`;
  }
  return `${altStr} - ${formatInt(b.limit)} TL arası yüzde ${oran}`;
}).join('; ');

// Açıklama için örnek hesap — hesaplayıcının kullandığı fonksiyonun kendisi
const ornBrut = 45000;
const orn = calculateNetFromGross(ornBrut);
const ornMatrah = ornBrut * (1 - SGK_RATES.employee - SGK_RATES.unemployment);
const asgariMatrah = MINIMUM_WAGE * (1 - SGK_RATES.employee - SGK_RATES.unemployment);

const faqItems = [
  {
    question: "Brüt ve net maaş farkı nedir?",
    answer: `Brüt maaş, kesintiler yapılmadan önceki toplam maaşındır. Net maaş ise SGK işçi payı (yüzde ${sgkYuzde}), işsizlik sigortası (yüzde ${issizlikYuzde}), gelir vergisi ve damga vergisi (yüzde ${damgaYuzde}) kesildikten sonra eline geçen tutardır.`,
  },
  {
    question: "Asgari ücret istisnası nedir?",
    answer: `${YEAR} brüt asgari ücreti ${minWageStr} TL'dir. Asgari ücrete isabet eden kısım gelir vergisi ve damga vergisinden muaftır; SGK ve işsizlik primi ise brütün tamamından kesilir. Bu yüzden asgari ücretlinin neti ${formatTL(asgariNet)} TL olur; daha yüksek maaşlarda vergi yalnızca asgari ücreti aşan kısım için hesaplanır.`,
  },
  {
    question: `${YEAR} gelir vergisi dilimleri nelerdir?`,
    answer: `${YEAR} gelir vergisi dilimleri: ${dilimAcik}. Gerçek bordroda vergi, yıl içinde biriken (kümülatif) matraha göre dilim dilim uygulanır. Bu hesaplayıcı ise sade bir tahmin için ilk dilimi (yüzde ${ilkDilimYuzde}) esas alır.`,
  },
  {
    question: "Brüt artınca net neden daha az artıyor?",
    answer: "Brüt arttığında SGK primi, işsizlik primi, gelir vergisi ve damga vergisi de artar. Ayrıca yıl ilerledikçe kümülatif matrah üst vergi dilimine geçebilir. Bu nedenle brüt maaştaki artışın tamamı nete yansımaz.",
  },
  {
    question: "Sonuç kesin mi?",
    answer: "Hayır, tahminidir. Gerçek bordro; yıl içinde biriken kümülatif vergi matrahı, üst vergi dilimleri ve iş yerine özgü kesintilerle muhasebe tarafından hesaplanır. Özellikle yılın son aylarında ve yüksek maaşlarda gerçek net, bu tahminden düşük çıkabilir.",
  },
];

const relatedTools = [
  {
    title: "Fazla Mesai Ücreti",
    url: "/fazla-mesai-hesaplama/",
    description: "Ayda kaç saat fazla mesai yaptıysan ücretini hesapla.",
  },
  {
    title: "Kıdem Tazminatı",
    url: "/kidem-tazminati-hesaplama/",
    description: "Kıdemin uzun olduğu durumlarda çıkış ücretini hesapla.",
  },
  {
    title: "İhbar Tazminatı",
    url: "/ihbar-tazminati-hesaplama/",
    description: "İşsiz kalmaya karşılık ödenecek tutarı öğren.",
  },
  {
    title: "Resmi Tatil Mesaisi",
    url: "/resmi-tatil-mesaisi-hesaplama/",
    description: "Resmi tatilde çalışma ücretini hesapla.",
  },
];
---

<BaseLayout
  title="Net-Brüt Maaş Hesaplama 2026 — Ücretsiz Online Çevirici"
  description="Brütten nete, netten brüte çevir. 2026 gelir vergisi dilimleri, SGK primi ve damga vergisiyle net maaşını anında, ücretsiz ve gizli hesapla."
>
  <Calculator
    title="Net-Brüt Maaş Çevirici"
    description="Brüt veya net maaşını gir, diğer tutar tüm kesintileriyle birlikte otomatik hesaplansın."
    resultLabel="Net Maaşın:"
    resultValue="TL 0,00"
  >
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <div>
        <label for="gross-netbrut">Aylık Brüt Maaş (TL)</label><br />
        <input
          id="gross-netbrut"
          type="number"
          placeholder="45000"
          min="0"
          step="100"
          value="45000"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div>
        <label for="net-netbrut">VEYA Aylık Net Maaş (TL)</label><br />
        <input
          id="net-netbrut"
          type="number"
          placeholder="0"
          min="0"
          step="100"
          value="0"
          style="width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; font-size: 1rem; min-height: 48px;"
        />
      </div>

      <div style="background: #f5f5f5; padding: 1rem; border-radius: 6px; border: 1px solid #ddd; font-size: 0.95rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span>Brüt Maaş:</span>
          <strong id="display-gross">TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>SGK + İşsizlik Kesintisi:</span>
          <strong id="display-sgk">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Gelir Vergisi:</span>
          <strong id="display-tax">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: #dc2626;">
          <span>Damga Vergisi:</span>
          <strong id="display-stamp">-TL 0,00</strong>
        </div>
        <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 2px solid #ddd; color: #10b981; font-size: 1.1rem;">
          <span style="font-weight: bold;">Net Maaş:</span>
          <strong id="display-net">TL 0,00</strong>
        </div>
      </div>
    </div>
  </Calculator>

  <Explanation>
    <p>
      Net maaş, brüt maaştan dört kalemin düşülmesiyle bulunur. Hesaplayıcı bunu
      hem brütten nete hem de netten brüte doğru yapar. Kesintiler:
    </p>
    <ul>
      <li><strong>SGK işçi payı (yüzde {sgkYuzde}) ve işsizlik sigortası (yüzde {issizlikYuzde}):</strong> Brüt maaşın tamamı üzerinden kesilir.</li>
      <li><strong>Gelir vergisi (yüzde {ilkDilimYuzde}):</strong> SGK sonrası kalan matrahtan asgari ücretin matrahı ({formatTL(asgariMatrah)} TL) düşülür; vergi kalan kısma uygulanır.</li>
      <li><strong>Damga vergisi (yüzde {damgaYuzde}):</strong> Brüt maaşın asgari ücreti ({minWageStr} TL) aşan kısmından alınır.</li>
    </ul>
    <div class="example">
      <p><strong>Örnek:</strong> Aylık {formatInt(ornBrut)} TL brüt maaş.</p>
      <p>SGK + işsizlik = {formatInt(ornBrut)} × yüzde {formatPercent(SGK_RATES.employee + SGK_RATES.unemployment, 0)} = {formatTL(orn.sgkDeduction)} TL.</p>
      <p>Gelir vergisi = ({formatTL(ornMatrah)} − {formatTL(asgariMatrah)}) × yüzde {ilkDilimYuzde} = {formatTL(orn.incomeTax)} TL.</p>
      <p>Damga vergisi = ({formatInt(ornBrut)} − {minWageStr}) × yüzde {damgaYuzde} = {formatTL(orn.stampTax)} TL.</p>
      <p class="result">Net maaş ≈ {formatTL(orn.net)} TL.</p>
    </div>
    <p>
      Not: Gerçek bordroda vergi, yıl boyunca biriken <strong>kümülatif matraha</strong>
      göre üst dilimlere geçtiği için aylar ilerledikçe net maaş bir miktar düşebilir.
      Bu araç ilk dilimi esas alarak kümülatif matrahı basitleştirdiğinden sonuç yaklaşıktır.
    </p>
  </Explanation>

  <FAQ title="Sık Sorulan Sorular" items={faqItems} />

  <RelatedTools tools={relatedTools} />

  <AppBox campaignName="net-brut" />

  <Disclaimer />
</BaseLayout>

<script>
  // Hesap mantığı tek kaynakta: utils/calc-web.ts (mobil uygulamayla birebir).
  // Asgari ücret ve oranlar constants/parameters.ts'ten gelir.
  import { calculateNetFromGross, calculateGrossFromNet } from '../utils/calc-web';

  const fmt = (n) => new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
  const EMPTY = { gross: 0, sgkDeduction: 0, incomeTax: 0, stampTax: 0, net: 0 };

  function displayResult(result) {
    document.getElementById('display-gross').textContent = `TL ${fmt(result.gross)}`;
    document.getElementById('display-sgk').textContent = `-TL ${fmt(result.sgkDeduction)}`;
    document.getElementById('display-tax').textContent = `-TL ${fmt(result.incomeTax)}`;
    document.getElementById('display-stamp').textContent = `-TL ${fmt(result.stampTax)}`;
    document.getElementById('display-net').textContent = `TL ${fmt(result.net)}`;

    const resultValue = document.getElementById('result-value');
    if (resultValue) resultValue.textContent = `TL ${fmt(result.net)}`;
  }

  function calculateFromGross() {
    const gross = parseFloat(document.getElementById('gross-netbrut').value) || 0;
    if (gross <= 0) {
      displayResult(EMPTY);
      return;
    }
    const result = calculateNetFromGross(gross);
    displayResult(result);
    document.getElementById('net-netbrut').value = result.net;
  }

  function calculateFromNet() {
    const net = parseFloat(document.getElementById('net-netbrut').value) || 0;
    if (net <= 0) {
      displayResult(EMPTY);
      document.getElementById('gross-netbrut').value = 0;
      return;
    }
    const result = calculateGrossFromNet(net);
    displayResult(result);
    document.getElementById('gross-netbrut').value = result.gross;
  }

  function init() {
    const grossInput = document.getElementById('gross-netbrut');
    const netInput = document.getElementById('net-netbrut');
    if (!grossInput || !netInput) {
      console.error('Net-brut: input elemanlari bulunamadi');
      return;
    }
    grossInput.addEventListener('input', calculateFromGross);
    netInput.addEventListener('input', calculateFromNet);
    calculateFromGross();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  label {
    display: block;
    font-weight: 500;
    color: #1f2937;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
</style>
