---
// Uygulama kutusu — her sayfada aynı
// Google Play rozeti (resmi stil), yeni sekmede mağazaya bağlanır.
// Mağaza linki UTM parametreli: hangi sayfanın kaç kullanıcı taşıdığı
// Play Console'dan görülebilsin diye utm_campaign her sayfada farklıdır.
export interface Props {
  campaignName: string;
}

const { campaignName } = Astro.props;

// Google Play mağaza linki — UTM parametreli
const playStoreUrl = `https://play.google.com/store/apps/details?id=com.yalcinkaya.mesaidefterim&utm_source=web&utm_campaign=${encodeURIComponent(campaignName)}`;
---

<section class="app-box">
  <div class="app-box-container">
    <div class="app-box-content">
      <h2 class="app-box-title">Mesai Defterim Uygulaması</h2>
      <p class="app-box-description">
        Bu hesabı her ay otomatik yapan, bordronla karşılaştıran uygulama.
      </p>

      <a
        href={playStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="play-store-link"
        aria-label="Mesai Defterim'i Google Play'den indir"
      >
        <span class="play-badge" role="img" aria-label="Google Play rozeti">
          <svg viewBox="0 0 180 53" width="180" height="53" xmlns="http://www.w3.org/2000/svg">
            <rect x="0.5" y="0.5" width="179" height="52" rx="8" fill="#000000" stroke="#A6A6A6" stroke-width="1"></rect>
            <!-- Play üçgeni (renkli) -->
            <g transform="translate(16, 14)">
              <path d="M0 1.2 L13.5 12.5 L0 23.8 Z" fill="#00D2FF"></path>
              <path d="M0 1.2 L8.6 12.5 L0 23.8 Z" fill="#00A0FF" opacity="0.85"></path>
              <path d="M0 1.2 L13.5 12.5 L9.4 8.4 Z" fill="#FFCE00"></path>
              <path d="M0 23.8 L13.5 12.5 L9.4 16.6 Z" fill="#FF3A44"></path>
            </g>
            <!-- Metin -->
            <text x="42" y="21" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="8" letter-spacing="0.5">İNDİRİN</text>
            <text x="42" y="39" fill="#FFFFFF" font-family="Arial, sans-serif" font-size="17" font-weight="600">Google Play</text>
          </svg>
        </span>
      </a>

      <p class="app-box-note">Mesai Defterim'i Google Play'den ücretsiz indir.</p>
    </div>
  </div>
</section>

<style>
  .app-box {
    padding: var(--space-2xl) var(--space-md);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
  }

  .app-box-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .app-box-content {
    text-align: center;
  }

  .app-box-title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-md);
    color: white;
  }

  .app-box-description {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-lg);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--line-height-relaxed);
  }

  .play-store-link {
    display: inline-block;
    border-radius: 8px;
    transition: transform 0.2s;
  }

  .play-store-link:hover {
    transform: scale(1.05);
  }

  .play-store-link:active {
    transform: scale(0.97);
  }

  .play-store-link:focus-visible {
    outline: 3px solid var(--color-success);
    outline-offset: 3px;
  }

  .play-badge {
    display: inline-block;
  }

  .play-badge svg {
    display: block;
  }

  .app-box-note {
    margin-top: var(--space-md);
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 768px) {
    .app-box {
      padding: var(--space-3xl) var(--space-md);
    }

    .app-box-title {
      font-size: var(--font-size-3xl);
    }
  }
</style>
