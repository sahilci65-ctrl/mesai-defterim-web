---
// Bağımsızlık beyanı — her sayfanın sonunda
export interface Props {
  // true ise hukuki uyuşmazlık yönlendirmesi de gösterilir (SSS'li sayfalar)
  legalNote?: boolean;
}

const { legalNote = false } = Astro.props;
---

<footer class="disclaimer">
  <div class="disclaimer-container">
    {legalNote && (
      <p class="disclaimer-text disclaimer-legal">
        Bu bilgiler bilgilendirme amaçlıdır; hukuki uyuşmazlıkta ALO 170'e veya
        bir iş hukuku avukatına başvurun.
      </p>
    )}
    <p class="disclaimer-text">
      Bu site bağımsız bir hesaplama aracıdır; T.C. Çalışma ve Sosyal Güvenlik
      Bakanlığı, SGK veya herhangi bir resmi kurumla ilişkisi yoktur.
      Hesaplamalar bilgilendirme amaçlıdır ve hukuki tavsiye yerine geçmez.
    </p>
    <nav class="disclaimer-links" aria-label="Alt bilgi bağlantıları">
      <a href="/gizlilik/">Gizlilik Politikası</a>
    </nav>
  </div>
</footer>

<style>
  .disclaimer {
    background-color: var(--color-gray-50);
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) var(--space-md);
  }

  .disclaimer-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .disclaimer-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    text-align: center;
  }

  .disclaimer-legal {
    margin-bottom: var(--space-md);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .disclaimer-links {
    margin-top: var(--space-md);
    text-align: center;
  }

  .disclaimer-links a {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .disclaimer-links a:hover {
    text-decoration: underline;
  }
</style>
